frontend/artifacts/mobile-app/sdk*.txt
frontend/artifacts/mobile-app/cmake_install.txt
frontend/artifacts/mobile-app/final_*.txt

# Additional patterns to cover infix-wildcard filenames
frontend/artifacts/mobile-app/*install.txt
frontend/artifacts/mobile-app/*analyze*.txt
frontend/artifacts/mobile-app/*verify*.txt

