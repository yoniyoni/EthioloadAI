# Environment Variables Configuration
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# JWT Configuration
# Minimum 32 characters required for security
JWT_SECRET=your-32-character-or-longer-secret-here

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/ethioloadai_spring
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Backblaze B2 private document storage (production only)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=freight-link-documents
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Expiration (optional - defaults to 15 minutes)
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# AI Engine Configuration (optional)
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_ENABLED=true

# Phase 2 invitations: supply real values only in ignored .env or deployment secrets.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
FRONTEND_BASE_URL=http://localhost:5173
INVITATION_EXPIRY_HOURS=24
INVITATION_COOLDOWN_SECONDS=60
INVITATION_MAX_PER_HOUR=20
# Optional: one controlled live verification email; read only by verification tooling.
INVITATION_TEST_RECIPIENT=