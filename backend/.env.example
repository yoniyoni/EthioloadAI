APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OSRM Routing Engine (self-hosted — see docker/osrm/). Road routing, road
# distance, ETA, turn-by-turn geometry only — nearby/proximity search stays on
# PostGIS. http://localhost:5001 assumes `docker compose up osrm` is running
# alongside a locally-run (non-Docker) backend; inside docker-compose itself
# this is overridden to the osrm service's internal DNS name (see ../.env.example).
OSRM_BASE_URL=http://localhost:5001

# Self-hosted Nominatim (geocoding) — replaces the public
# nominatim.openstreetmap.org instance (1 req/s cap, not for production
# use). `docker compose up -d nominatim` in docker/ to bring it up.
NOMINATIM_BASE_URL=http://localhost:8088

# Chapa payment gateway (https://developer.chapa.co) — powers the shipper's
# "Pay Now" flow only (my_bookings_screen.dart); driver-side self-reported
# payment sheets are unaffected. Use a CHASECK_TEST-... key from a Chapa
# sandbox account for pre-production testing.
CHAPA_SECRET_KEY=

# 'mock' (default) simulates payment/payout instantly via an internal
# checkout page — no Chapa account needed to test the whole escrow flow.
# Switch to 'chapa' once CHAPA_SECRET_KEY above is set to a real key.
PAYMENT_GATEWAY_DRIVER=mock

# 'mock' (default) logs the forgot-password SMS code instead of sending it —
# no SMS provider account needed to test that flow. No real provider is
# wired up yet; see SmsService before switching this.
SMS_GATEWAY_DRIVER=mock

# Platform commission taken from each booking's price, released to the
# driver net of this — see PaymentService.
COMMISSION_RATE=0.02
