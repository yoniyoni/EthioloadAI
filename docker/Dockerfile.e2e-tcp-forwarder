FROM golang:1.25-alpine AS build

WORKDIR /src
COPY docker/e2e-tcp-forwarder/go.mod ./go.mod
COPY docker/e2e-tcp-forwarder/main.go docker/e2e-tcp-forwarder/main_test.go ./
RUN go test ./...
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /e2e-tcp-forwarder .

FROM scratch
COPY --from=build /e2e-tcp-forwarder /e2e-tcp-forwarder
USER 10001:10001
ENTRYPOINT ["/e2e-tcp-forwarder"]
CMD ["serve"]
